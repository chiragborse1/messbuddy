# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Large binaries / executables
*.exe
*.backup
bun.lockb

# Supabase migration SQL is tracked; ad hoc SQL dumps are ignored.
*.sql
!supabase/migrations/*.sql
supabase/.temp/
