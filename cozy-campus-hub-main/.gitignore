dist
dist-ssr
*.local

# Environment variables (NEVER commit these - contains Supabase keys!)
.env
.env.*

# Local secret upload helpers / downloaded service-account keys
upload_secret.js
*service-account*.json
*firebase-adminsdk*.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vade-report
