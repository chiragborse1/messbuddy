// Scripts for firebase messaging
importScripts("https://www.gstatic.com/firebasejs/9.0.0/firebase-app-compat.js");
importScripts("https://www.gstatic.com/firebasejs/9.0.0/firebase-messaging-compat.js");

// 🚨 PASTE YOUR SAME FIREBASE CONFIG HERE TOO 🚨
// The service worker needs this to run in the background
const firebaseConfig = {
    apiKey: "AIzaSyA4HSDQk7JzenIVaqHOmhWUQISVRL6Nhfk",
    authDomain: "cozy-campus.firebaseapp.com",
    projectId: "cozy-campus",
    storageBucket: "cozy-campus.firebasestorage.app",
    messagingSenderId: "541064791428",
    appId: "1:541064791428:web:4e7f4ceaefa4b4e6fd89d1",
    measurementId: "G-Z0NMXCCWK5"
};

firebase.initializeApp(firebaseConfig);

const messaging = firebase.messaging();

// Background Message Handler
messaging.onBackgroundMessage(function (payload) {
    console.log('[firebase-messaging-sw.js] Received background message ', payload);
    // Customize notification here
    const notificationTitle = payload.notification.title;
    const notificationOptions = {
        body: payload.notification.body,
        icon: '/icon-192x192.png' // Ensure you have an icon in public folder
    };

    self.registration.showNotification(notificationTitle, notificationOptions);
});
